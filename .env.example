# Pinned Aegra CLI runtime config
AUTH_TYPE=noop
PORT=4242

# PostgreSQL — managed by `aegra dev`. Override only if you know what you're doing.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegra
POSTGRES_PORT=4243

# --- LLM provider — set ONE of the sections below ---

# OpenAI (cloud)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3

# --- Observability (optional) ---
LANGFUSE_LOGGING=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
